---
interface Media {
  src: string;
  alt: string;
}

interface Props {
  slug: string;
  theme: 'jahota' | 'talktube' | 'nfhs' | 'tangible';
  category: string;
  title: string;
  description: string;
  year: string;
  facts: string[];
  href: string;
  primary: Media;
  secondary: Media;
  layout?: 'forward' | 'reverse';
}

const {
  slug,
  theme,
  category,
  title,
  description,
  year,
  facts,
  href,
  primary,
  secondary,
  layout = 'forward',
} = Astro.props;

const responsiveSet = (src: string) =>
  `${src.replace('.webp', '-480.webp')} 480w, ${src.replace('.webp', '-900.webp')} 900w, ${src} 1100w`;
---

<article
  id={slug}
  class:list={['project-card', `project-card--${theme}`, `project-card--${layout}`]}
  data-reveal
>
  <div class="project-card__copy">
    <p class="project-kicker">
      <span>{category}</span>
      <span>{year}</span>
    </p>

    <h3>
      <a href={href}>
        {title}
        <span class="project-title-arrow" aria-hidden="true">→</span>
      </a>
    </h3>

    <p class="project-summary">{description}</p>

    <ul class="project-facts" aria-label="Project highlights">
      {facts.map((fact) => <li>{fact}</li>)}
    </ul>

    <a class="project-link" href={href}>
      Read the full case study
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="project-card__media" data-parallax-scope>
    <svg class="project-thread" viewBox="0 0 720 540" aria-hidden="true">
      <path d="M36 396C116 300 174 466 260 352C347 236 393 357 468 236C532 133 600 154 687 72"
      ></path>
      <circle cx="36" cy="396" r="11"></circle>
      <circle cx="687" cy="72" r="11"></circle>
    </svg>

    <figure class="project-media project-media--primary" data-parallax="10">
      <img
        src={primary.src}
        srcset={responsiveSet(primary.src)}
        sizes="(max-width: 820px) 86vw, min(54vw, 760px)"
        alt={primary.alt}
        loading="lazy"
        decoding="async"
      />
    </figure>

    <figure class="project-media project-media--secondary" data-parallax="-14">
      <img
        src={secondary.src}
        srcset={responsiveSet(secondary.src)}
        sizes="(max-width: 820px) 58vw, min(33vw, 470px)"
        alt={secondary.alt}
        loading="lazy"
        decoding="async"
      />
    </figure>

    <p class="project-stamp" aria-hidden="true">
      {theme === 'jahota' && 'FIELD / SYSTEM'}
      {theme === 'talktube' && 'HEAR / SPEAK'}
      {theme === 'nfhs' && 'TOOL / FLOW'}
      {theme === 'tangible' && 'DATA / MATERIAL'}
    </p>
  </div>
</article>
