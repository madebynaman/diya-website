---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageScripts from '../components/PageScripts.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout
  title="About Diya Sharma — Interaction designer"
  description="Diya Sharma is an interaction designer working across field research, systems thinking, digital products, and visual craft."
  ogImage="/images/diya-portrait.webp"
>
  <div class="about-page">
    <SiteHeader current="about" />

    <main id="main">
      <section class="about-page-hero" id="top" aria-labelledby="about-page-title">
        <svg
          class="about-page-thread"
          viewBox="0 0 1440 860"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M-60 667C155 697 148 328 371 351C574 371 536 715 757 625C951 545 889 180 1111 205C1278 224 1334 402 1500 324"
          ></path>
        </svg>

        <div class="about-page-hero__copy">
          <p class="eyebrow">A little about me</p>
          <h1 id="about-page-title">I look for the human part inside complicated systems.</h1>
          <p>
            I’m Diya, an interaction designer blending research and technology to create intuitive
            digital experiences. I focus on making complex ideas feel simple and human—with intent,
            empathy, and just the right amount of craft.
          </p>
          <div class="about-page-hero__actions">
            <a class="button button--ink" href="/#work"
              >See selected work <span aria-hidden="true">↘</span></a
            >
            <a class="text-link" href="/contact">Discuss a project ↗</a>
          </div>
        </div>

        <div class="about-page-portrait" data-parallax-scope>
          <div class="about-page-portrait__pattern" aria-hidden="true"></div>
          <figure data-parallax="9">
            <img
              src="/images/diya-portrait.webp"
              srcset="/images/diya-portrait-480.webp 480w, /images/diya-portrait-900.webp 900w, /images/diya-portrait.webp 1100w"
              sizes="(max-width: 600px) 73vw, (max-width: 900px) min(68vw, 476px), min(27vw, 380px)"
              alt="Diya Sharma smiling against a textured brown wall"
              width="1100"
              height="1955"
              fetchpriority="high"
            />
            <figcaption>Curious by default</figcaption>
          </figure>
          <p class="about-page-portrait__note" data-parallax="-7">
            Research<br />→ system<br />→ interaction
          </p>
        </div>
      </section>

      <section class="about-page-practice" aria-labelledby="practice-title">
        <header data-reveal>
          <p class="eyebrow">How I work</p>
          <h2 id="practice-title">
            Pay attention first. Make the system visible. Then shape the interaction.
          </h2>
        </header>

        <div class="about-page-practice__grid">
          <article data-reveal>
            <span aria-hidden="true">◉</span>
            <h3>Stay close to context</h3>
            <p>
              Field visits, interviews, observation, and testing reveal the workarounds a diagram
              alone cannot show.
            </p>
          </article>
          <article data-reveal>
            <span aria-hidden="true">⌁</span>
            <h3>Connect the parts</h3>
            <p>
              Actor maps, flows, and feedback loops turn scattered touchpoints into a system that
              can be discussed and changed.
            </p>
          </article>
          <article data-reveal>
            <span aria-hidden="true">✦</span>
            <h3>Make ideas tangible</h3>
            <p>
              Interfaces, prototypes, diagrams, and physical craft give teams something concrete
              enough to test and refine.
            </p>
          </article>
        </div>
      </section>

      <section class="about-page-details" aria-labelledby="experience-title">
        <div class="about-page-details__intro" data-reveal>
          <p class="eyebrow">Experience + capabilities</p>
          <h2 id="experience-title">Working between research, systems, and interfaces.</h2>
          <p>
            My practice moves from understanding how a service works today to shaping the digital
            experience it could become.
          </p>
        </div>

        <div class="about-page-details__content" data-reveal>
          <div class="about-page-role">
            <div>
              <p>Planway</p>
              <h3>User Experience Designer — Intern</h3>
            </div>
            <time datetime="2025-06">June–July 2025</time>
          </div>

          <ul class="about-page-capabilities" aria-label="Design capabilities">
            <li>Web design</li>
            <li>Mobile app design</li>
            <li>Usability testing</li>
            <li>Primary research</li>
          </ul>
        </div>
      </section>

      <section class="about-page-contact" aria-labelledby="about-contact-title" data-reveal>
        <p class="eyebrow">Let’s work together</p>
        <h2 id="about-contact-title">Have a system that needs untangling?</h2>
        <a href="/contact">Start a conversation <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <SiteFooter />
    <PageScripts />
  </div>
</BaseLayout>
